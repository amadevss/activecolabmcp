# Clave para proteger el servidor MCP (mínimo 16 caracteres).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MCP_SECRET=

# ID de tu cuenta de ActiveCollab en la nube: el número de https://app.activecollab.com/123456
ACTIVECOLLAB_ACCOUNT_ID=

# Token de la API (recomendado). Se obtiene con:  npm run get-token
ACTIVECOLLAB_TOKEN=

# Alternativa al token: el servidor lo pide con email y contraseña.
# No funciona si la cuenta tiene verificación en dos pasos.
# ACTIVECOLLAB_EMAIL=
# ACTIVECOLLAB_PASSWORD=

# Opcional: "true" para que Claude solo pueda leer (bloquea crear, editar y borrar).
# ACTIVECOLLAB_READ_ONLY=false

# Opcional: solo para instalaciones propias (self-hosted), p. ej. https://pm.miempresa.com
# ACTIVECOLLAB_BASE_URL=

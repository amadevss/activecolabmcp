# ---------- Obligatoria ----------

# Clave maestra para cifrar los tokens (mínimo 32 caracteres).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si la cambias, todas las personas tendrán que volver a iniciar sesión.
AUTH_SECRET=

# ---------- Recomendadas ----------

# URL pública del servidor, sin barra final.
# PUBLIC_URL=https://tu-app.vercel.app

# Límite de intentos de login (Upstash Redis). La integración de Upstash en Vercel las crea sola
# (también acepta KV_REST_API_URL / KV_REST_API_TOKEN). Sin ellas no hay límite de intentos.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Servidor privado: IDs de las cuentas de ActiveCollab que pueden usarlo (separados por comas).
# Es el número de https://app.activecollab.com/123456. Vacío = cualquier cuenta de ActiveCollab.
# ACTIVECOLLAB_ALLOWED_ACCOUNT_IDS=123456

# ---------- Opcionales ----------

# "true" para que Claude solo pueda leer (bloquea crear, editar y borrar).
# ACTIVECOLLAB_READ_ONLY=false

# Datos que se muestran en la página pública, la política de privacidad y los términos.
# SERVICE_NAME=ActiveCollab MCP
# SERVICE_OWNER_NAME=
# SERVICE_CONTACT_EMAIL=

# Hosts extra a los que se permite volver tras el login (por defecto claude.ai, claude.com y localhost).
# OAUTH_ALLOWED_REDIRECT_HOSTS=

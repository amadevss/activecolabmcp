# Clave maestra para cifrar los tokens (mínimo 32 caracteres). OBLIGATORIA.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si la cambias, todas las personas tendrán que volver a iniciar sesión.
AUTH_SECRET=

# URL pública del servidor, sin barra final. Recomendado en producción.
# PUBLIC_URL=https://tu-app.vercel.app

# Recomendado: IDs de las cuentas de ActiveCollab que pueden usar el servidor (separados por comas).
# Es el número de https://app.activecollab.com/123456. Vacío = cualquier cuenta de ActiveCollab.
# ACTIVECOLLAB_ALLOWED_ACCOUNT_IDS=123456

# Opcional: "true" para que Claude solo pueda leer (bloquea crear, editar y borrar).
# ACTIVECOLLAB_READ_ONLY=false

# Opcional: hosts extra a los que se permite volver tras el login (por defecto claude.ai, claude.com y localhost).
# OAUTH_ALLOWED_REDIRECT_HOSTS=
